# Folder watched for source documents (created/modified/deleted files drive ingestion)
WATCHED_FOLDER_PATH=./data/corpus

# Target chunk size for hybrid chunking, in characters (default: 2000)
CHUNK_SIZE_CHARS=2000

# Ordered access tiers, lowest to highest (JSON list). A document's tier is
# its top-level subfolder under WATCHED_FOLDER_PATH, e.g. tier-2/report.txt.
ACCESS_TIERS=["tier-1", "tier-2", "tier-3"]

# Local Ollama server and the model it embeds text with
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSIONS=768

# Qdrant: local/embedded mode (on-disk storage, no server process). Swap
# for a real Qdrant server later by passing a url= instead of path= to
# QdrantClient - see src/agentic_rag/indexing/qdrant_setup.py.
QDRANT_STORAGE_PATH=./data/qdrant
QDRANT_COLLECTION_NAME=documents

# Sparse (BM25-style) embedding model for the keyword half of hybrid search,
# via fastembed - runs locally, no server, downloads a small tokenizer/vocab
# bundle on first use.
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# Number of fused hybrid-search candidates retrieved before reranking
RETRIEVAL_TOP_K_CANDIDATES=10

# Local cross-encoder reranker (via fastembed) and how many chunks it keeps
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=4

# Generation model (Ollama) used for query rewriting, decomposition, and
# final answer generation
GENERATION_MODEL=mistral
GENERATION_TIMEOUT_SECONDS=60

# Max full re-decomposition attempts in the retrieval replanning loop before
# giving up and returning the canonical "I do not know" fallback
MAX_RETRIEVAL_ATTEMPTS=5
