# Folder watched for source documents (created/modified/deleted files drive ingestion)
WATCHED_FOLDER_PATH=./data/corpus

# How often the background sync job polls WATCHED_FOLDER_PATH for changes
# and propagates them to the index (FR4: edits within minutes, deletions
# immediately). 60s comfortably meets the "within minutes" target for edits;
# a deletion's own propagation step (a plain Qdrant delete, no embedding
# needed) is effectively immediate once a cycle detects it - see
# src/agentic_rag/ingestion/scheduler.py
SYNC_INTERVAL_SECONDS=60

# Target chunk size for hybrid chunking, in characters (default: 2000)
CHUNK_SIZE_CHARS=2000

# Ordered access tiers, lowest to highest (JSON list). A document's tier is
# its top-level subfolder under WATCHED_FOLDER_PATH, e.g. tier-2/report.txt.
ACCESS_TIERS=["tier-1", "tier-2", "tier-3"]

# Local Ollama server and the model it embeds text with
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSIONS=768

# Qdrant: local/embedded mode (on-disk storage, no server process). Swap
# for a real Qdrant server later by passing a url= instead of path= to
# QdrantClient - see src/agentic_rag/indexing/qdrant_setup.py.
QDRANT_STORAGE_PATH=./data/qdrant
QDRANT_COLLECTION_NAME=documents

# Sparse (BM25-style) embedding model for the keyword half of hybrid search,
# via fastembed - runs locally, no server, downloads a small tokenizer/vocab
# bundle on first use.
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# Number of fused hybrid-search candidates retrieved before reranking
RETRIEVAL_TOP_K_CANDIDATES=10

# Local cross-encoder reranker (via fastembed) and how many chunks it keeps
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=4

# Generation model (Ollama) used for query rewriting, decomposition, and
# final answer generation
GENERATION_MODEL=mistral
GENERATION_TIMEOUT_SECONDS=60

# Max full re-decomposition attempts in the retrieval replanning loop before
# giving up and returning the canonical "I do not know" fallback
MAX_RETRIEVAL_ATTEMPTS=5

# Cosine similarity a past query's embedding must meet to serve its cached
# answer instead of re-running retrieval + generation (semantic cache)
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95

# How long a semantic cache entry stays servable before it's treated as
# expired. Bounds (does not eliminate) the exposure window for a cached
# answer citing content that's since been deleted or reclassified to a
# stricter access tier - see SemanticCache's docstring for why this can't
# be solved with an unbounded cache
SEMANTIC_CACHE_TTL_SECONDS=300

# Sampling temperature for LLM-based judge/classification calls (the
# prompt-injection judge, output/citation security check) - low by design
# so the same input reliably produces the same verdict. Discovered as a
# real, not just theoretical, need: the identical adversarial prompt
# passed one live-test run and failed an immediate re-run at Ollama's
# default (non-zero) temperature, with no code change in between
JUDGE_TEMPERATURE=0.0

# Sampling temperature for the final grounded-answer generation call
# (generate_answer()) - a separate setting from JUDGE_TEMPERATURE, not a
# reuse of it, since the tradeoff differs: a judge's single-word verdict
# has no reason to vary, but a natural-language answer's phrasing
# plausibly could. Defaults to the same 0.0 anyway because live testing
# found this isn't just a style question here: the identical, already-
# sufficient retrieval result produced the correct cited answer on 2 of 3
# identical calls and the "I do not know" fallback on the third at
# Ollama's default (non-zero) temperature - a correctness bug, not flaky
# phrasing
GENERATION_TEMPERATURE=0.0

# Sampling temperature for rewrite_query() (multi-turn history resolution).
# Called once per turn with no retry, unlike decompose_query() below - the
# same conversation should always resolve "it"/"them" to the same
# self-contained question, so this is pinned low like GENERATION_TEMPERATURE
REWRITE_TEMPERATURE=0.0

# Sampling temperature for decompose_query()'s FIRST attempt within
# plan_and_retrieve()'s retry loop - low by design, for the same reason as
# GENERATION_TEMPERATURE: live testing found identical calls at Ollama's
# default temperature produced different sub-question pairs, sometimes
# wrongly judging a retrievable query "insufficient" by chance
DECOMPOSE_TEMPERATURE=0.0

# Sampling temperature for decompose_query() on every RETRY attempt after
# the first (plan_and_retrieve()'s retry loop) - deliberately higher than
# DECOMPOSE_TEMPERATURE: retrying with the same deterministic decomposition
# would just reproduce the same "insufficient" result, so a retry only has
# a chance of succeeding if it explores a genuinely different phrasing -
# see plan_and_retrieve()'s docstring (orchestration/planning.py)
DECOMPOSE_RETRY_TEMPERATURE=0.4
